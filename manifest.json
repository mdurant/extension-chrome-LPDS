{
  "manifest_version": 3,
  "name": "Ley 21.719 — Indicios de Cumplimiento",
  "version": "1.2.0",
  "description": "Indicios web Ley 21.719 (Chile): transparencia, cookies y formularios. Por Mauricio Durán Torres.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ley 21.719 — Indicios web"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
